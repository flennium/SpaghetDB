    "idb": "^8.0.3",
    "lucide-react": "^1.47.0",
    "monaco-editor": "^0.52.2",
    "node-sql-parser": "^5.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
